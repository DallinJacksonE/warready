# Copy to .env and replace every CHANGE_ME with a unique random password (12+ characters).
MYSQL_DATABASE=warready
MYSQL_USER=warready
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
ADMIN1_USERNAME=dj
ADMIN1_NAME=DJ
ADMIN1_PASSWORD=CHANGE_ME_FIRST_ADMIN_PASSWORD
ADMIN2_USERNAME=brother
ADMIN2_NAME=Brother
ADMIN2_PASSWORD=CHANGE_ME_SECOND_ADMIN_PASSWORD
# Host port for the website/API, bound only to 127.0.0.1. Choose an unused port.
# Internal app (3000) and MySQL (3306) ports are isolated; MySQL is not published.
APP_PORT=8080
# Leave empty for http://localhost:<APP_PORT> when using Docker Compose locally.
# For Cloudflare Tunnel, set your exact public HTTPS origin (no trailing slash).
APP_ORIGIN=
# Set true when accessing the site through Cloudflare's public HTTPS hostname.
COOKIE_SECURE=false
